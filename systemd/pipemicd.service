[Unit]
Description=Pipemic mixer daemon (PipeWire)
Documentation=https://github.com/davidboulay/pipemic
After=pipewire.service wireplumber.service
Wants=wireplumber.service
Requires=pipewire.service

[Service]
ExecStart=%h/.local/bin/pipemicd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=pipewire.service
