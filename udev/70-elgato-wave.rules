# Elgato Wave:3 (0fd9:0070): let the logged-in seat user open the device so
# pipemicctl / pipemicd can claim the vendor interface (3) without root.
# Install:  sudo install -m644 udev/70-elgato-wave.rules /etc/udev/rules.d/
#           sudo udevadm control --reload && sudo udevadm trigger -s usb
# Then replug the mic.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTRS{idVendor}=="0fd9", ATTRS{idProduct}=="0070", MODE="0660", TAG+="uaccess"
# Wave:3 in DFU/bootloader mode (after vendor request 0xF2): needed for firmware updates.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTRS{idVendor}=="0fd9", ATTRS{idProduct}=="0071", MODE="0660", TAG+="uaccess"
